<view class="tab-bar">
  <view class="tab-bar__inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item--active' : ''}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <view class="tab-item__icon-wrap">
        <image class="tab-item__icon" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit"></image>
      </view>
      <view class="tab-item__text">{{item.text}}</view>
    </view>
  </view>
</view>
