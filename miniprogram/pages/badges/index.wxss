.badge-hero {
  padding: 32rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 24rpx;
  color: #333333;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.badge-hero__eyebrow {
  color: #777777;
  font-size: 24rpx;
}

.badge-hero__title {
  margin-top: 6rpx;
  color: #333333;
  font-size: 36rpx;
  font-weight: 600;
}

.badge-hero__text {
  margin-top: 12rpx;
  color: #999999;
  font-size: 24rpx;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 32rpx;
  margin-top: 32rpx;
}

.badge-card {
  padding: 32rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 24rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.badge-card--locked {
  background: #ffffff;
}

.badge-medal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 15rpx;
  border: 8rpx solid #e6f1ed;
  border-radius: 50%;
  color: #ffffff;
  background: #2f7257;
  font-size: 32rpx;
  font-weight: 600;
}

.badge-medal--gold {
  border-color: #e6f1ed;
  background: #d99a3d;
}

.badge-medal--blue {
  border-color: #e6f1ed;
  background: #4c7fa3;
}

.badge-medal--cyan {
  border-color: #e6f1ed;
  background: #4c7fa3;
}

.badge-medal--purple {
  border-color: #e6f1ed;
  background: #d26e5b;
}

.badge-medal--orange {
  border-color: #e6f1ed;
  background: #d99a3d;
}

.badge-medal--locked {
  filter: grayscale(1);
  opacity: 0.36;
}

.badge-name {
  color: #333333;
  font-size: 24rpx;
  font-weight: 500;
}

.badge-desc {
  min-height: 66rpx;
  margin-top: 6rpx;
  color: #777777;
  font-size: 24rpx;
}

.badge-progress {
  height: 9rpx;
  overflow: hidden;
  margin: 14rpx 0 8rpx;
  border-radius: 999rpx;
  background: #eeeeee;
}

.badge-progress__bar {
  height: 100%;
  border-radius: 999rpx;
  background: #2f7257;
}
