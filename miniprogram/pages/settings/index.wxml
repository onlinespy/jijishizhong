<view class="page">
  <view class="section-head">
    <view class="section-title">订阅消息管理</view>
    <view class="tag">{{cloudEnabled ? '云开发已启用' : '本地模式'}}</view>
  </view>

  <view class="card setting-list">
    <view class="setting-row">
      <view class="setting-symbol setting-symbol--blue">水</view>
      <view class="grow">
        <view class="setting-title">喝水提醒</view>
        <view class="tiny muted">需用户主动授权订阅，可随时关闭</view>
      </view>
      <switch color="#2F7257" data-type="water" checked="{{waterReminder}}" bindchange="toggleReminder" />
    </view>
    <view class="setting-row">
      <view class="setting-symbol setting-symbol--rose">期</view>
      <view class="grow">
        <view class="setting-title">经期提醒</view>
        <view class="tiny muted">仅在授权后通过微信订阅消息发送</view>
      </view>
      <switch color="#2F7257" data-type="period" checked="{{periodReminder}}" bindchange="toggleReminder" />
    </view>
  </view>

  <view class="disclaimer">
    微信小程序无法后台常驻定时推送。提醒消息仅能在用户主动授权后，由微信订阅消息能力发送；拒绝授权不影响任何记录功能。
  </view>

  <view class="section-head section-gap">
    <view class="section-title">协议与说明</view>
  </view>
  <view class="card setting-list">
    <button class="setting-row setting-row--button" data-type="privacy" bindtap="openAgreement">
      <view class="setting-symbol">隐</view>
      <view class="grow">
        <view class="setting-title">隐私政策</view>
        <view class="tiny muted">查看数据收集、用途与删除方式</view>
      </view>
      <view class="menu-arrow">›</view>
    </button>
    <button class="setting-row setting-row--button" data-type="disclaimer" bindtap="openAgreement">
      <view class="setting-symbol setting-symbol--gray">免</view>
      <view class="grow">
        <view class="setting-title">全局免责声明</view>
        <view class="tiny muted">产品定位与使用边界</view>
      </view>
      <view class="menu-arrow">›</view>
    </button>
  </view>

  <view class="section-head section-gap">
    <view class="section-title">数据管理</view>
  </view>
  <view class="card">
    <view class="data-copy">
      <view class="strong">清除本地与云端打卡记录</view>
      <view class="small muted">个人档案、断食计划和订阅开关会保留。</view>
    </view>
    <button class="danger-button" bindtap="clearRecords">清除全部记录</button>
  </view>

  <view wx:if="{{demoDataEnabled}}">
    <view class="section-head section-gap">
      <view class="section-title">开发辅助</view>
      <view class="tag">仅演示</view>
    </view>
    <view class="card">
      <view class="data-copy">
        <view class="strong">生成软著演示数据</view>
        <view class="small muted">写入连续两周的打卡记录，用于页面截图。正式上传前请将 demoDataEnabled 改为 false。</view>
      </view>
      <button class="secondary-button" bindtap="fillDemoData">生成演示数据</button>
    </view>
  </view>

  <view class="version">记记食钟 {{version}}</view>
</view>
