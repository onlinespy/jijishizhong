<view class="page page--tab records-page">
  <view class="records-header">
    <view>
      <view class="records-header__eyebrow">选择记录日期</view>
      <picker mode="date" value="{{selectedDate}}" bindchange="changeSelectedDate">
        <view class="records-header__date">{{selectedDateLabel}}⌄</view>
      </picker>
    </view>
    <view class="records-header__tip">仅作记录</view>
  </view>

  <view class="tab-switch">
    <button
      wx:for="{{tabs}}"
      wx:key="id"
      class="record-tab {{activeTab === item.id ? 'record-tab--active' : ''}}"
      data-tab="{{item.id}}"
      bindtap="switchTab"
    >
      {{item.name}}
    </button>
  </view>

  <view class="more-record-row">
    <button class="more-record-button {{activeTab === 'weight' ? 'more-record-button--active' : ''}}" data-tab="weight" bindtap="switchTab">体重记录</button>
    <button
      wx:if="{{showPeriodEntry}}"
      class="more-record-button {{activeTab === 'period' ? 'more-record-button--active' : ''}}"
      data-tab="period"
      bindtap="switchTab"
    >
      经期记录
    </button>
  </view>

  <block wx:if="{{activeTab === 'diet'}}">
    <view class="card">
      <view class="section-head">
        <view class="section-title">添加饮食</view>
        <view class="small muted">今日 {{dietTotal}} kcal</view>
      </view>

      <view class="form-item">
        <view class="form-label">餐次</view>
        <view class="chip-row">
          <button
            wx:for="{{mealTypes}}"
            wx:key="*this"
            class="chip {{activeMeal === item ? 'chip--active' : ''}}"
            data-value="{{item}}"
            bindtap="selectMeal"
          >
            {{item}}
          </button>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">录入方式</view>
        <view class="segmented">
          <button class="segmented__item {{dietMode === 'library' ? 'segmented__item--active' : ''}}" data-value="library" bindtap="changeDietMode">基础食物库</button>
          <button class="segmented__item {{dietMode === 'manual' ? 'segmented__item--active' : ''}}" data-value="manual" bindtap="changeDietMode">手动录入</button>
        </view>
      </view>

      <block wx:if="{{dietMode === 'library'}}">
        <view class="form-item">
          <view class="form-label">搜索食物</view>
          <input class="input" value="{{foodSearch}}" placeholder="输入食物名称" bindinput="onFoodSearchInput" />
        </view>

        <view class="form-item">
          <view class="form-label">食物分类</view>
          <view class="food-category-grid">
            <button
              wx:for="{{foodGroups}}"
              wx:key="id"
              class="chip category-button {{activeFoodGroup === item.id ? 'chip--active' : ''}}"
              data-id="{{item.id}}"
              bindtap="selectFoodGroup"
            >
              {{item.name}}
            </button>
          </view>
        </view>

        <view class="food-grid">
          <button
            wx:for="{{visibleFoods}}"
            wx:key="id"
            class="food-item {{selectedFood.id === item.id ? 'food-item--active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectFood"
          >
            <view class="food-item__name">{{item.name}}</view>
            <view class="tiny muted">{{item.kcalPer100g}} kcal/100g</view>
          </button>
        </view>

        <view class="selected-food" wx:if="{{selectedFood}}">
          <view class="row-between">
            <view class="strong">{{selectedFood.name}}</view>
            <view class="tag">参考值</view>
          </view>
          <view class="form-item compact-form-item">
            <view class="food-input-row">
              <input
                class="gram-input"
                type="number"
                value="{{foodAmount}}"
                placeholder="请输入食用量数值"
                bindinput="onFoodAmountInput"
              />
              <view class="unit-switch">
                <view
                  wx:for="{{foodUnits}}"
                  wx:key="*this"
                  class="unit-btn {{foodUnit === item ? 'unit-btn--active' : ''}}"
                  data-value="{{item}}"
                  bindtap="selectFoodUnit"
                >
                  {{item}}
                </view>
              </view>
            </view>
          </view>
          <view class="preview-line">
            <text>参考热量</text>
            <text class="preview-line__value">{{foodPreviewKcal}} kcal</text>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="form-item">
          <view class="form-label">食物名称</view>
          <input class="input" data-field="manualName" value="{{manualName}}" placeholder="例如：自制牛肉面" bindinput="onManualInput" />
        </view>
        <view class="two-column">
          <view class="form-item">
            <view class="form-label">食用分量</view>
            <input class="input" type="digit" data-field="manualAmount" value="{{manualAmount}}" placeholder="例如：1" bindinput="onManualInput" />
          </view>
          <view class="form-item">
            <view class="form-label">单位</view>
            <input class="input" data-field="manualUnit" value="{{manualUnit}}" placeholder="份/克/碗" bindinput="onManualInput" />
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">参考热量（kcal）</view>
          <input class="input" type="digit" data-field="manualKcal" value="{{manualKcal}}" placeholder="请填写营养标签或自行估算" bindinput="onManualInput" />
        </view>
      </block>

      <button class="primary-button" bindtap="saveDiet">保存饮食记录</button>
    </view>

    <view class="section-head">
      <view class="section-title">当日饮食</view>
      <button class="text-button" bindtap="copyYesterdayDiet">复制昨日饮食</button>
    </view>
    <view class="card record-list" wx:if="{{dietRecords.length}}">
      <view class="record-row" wx:for="{{dietRecords}}" wx:key="id">
        <view class="record-row__icon">{{item.mealType}}</view>
        <view class="grow">
          <view class="strong">{{item.name}}</view>
          <view class="tiny muted">{{item.mealType}} · {{item.amount || 1}}{{item.unit || '份'}}</view>
        </view>
        <view class="record-row__value">{{item.kcal}} kcal</view>
        <button class="delete-link" data-collection="dietRecords" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
      </view>
    </view>
    <view class="card empty" wx:else>暂无饮食记录，点击上方添加食物</view>
  </block>

  <block wx:elif="{{activeTab === 'exercise'}}">
    <view class="card">
      <view class="section-head">
        <view class="section-title">添加运动</view>
        <view class="small muted">今日 {{exerciseTotal}} kcal</view>
      </view>

      <view class="segmented form-item">
        <button
          wx:for="{{exerciseModes}}"
          wx:key="id"
          class="segmented__item {{exerciseMode === item.id ? 'segmented__item--active' : ''}}"
          data-value="{{item.id}}"
          bindtap="changeExerciseMode"
        >
          {{item.name}}
        </button>
      </view>

      <block wx:if="{{exerciseMode === 'library'}}">
        <view class="exercise-grid">
          <button
            wx:for="{{exerciseLibrary}}"
            wx:key="id"
            class="exercise-item {{selectedExerciseId === item.id ? 'exercise-item--active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectExercise"
          >
            <view class="exercise-item__icon">{{item.icon}}</view>
            <view>{{item.name}}</view>
          </button>
        </view>
        <view class="form-item">
          <view class="form-label">运动时长（分钟）</view>
          <input class="input" type="number" value="{{exerciseDuration}}" placeholder="请输入时长" bindinput="onExerciseDurationInput" />
        </view>
        <view class="preview-line">
          <view>
            <view class="strong">参考运动消耗</view>
            <view class="tiny muted">按档案体重 {{profile.weight || '--'}}kg 估算</view>
          </view>
          <text class="preview-line__value">{{exercisePreviewKcal}} kcal</text>
        </view>
      </block>

      <block wx:else>
        <view class="form-item">
          <view class="form-label">运动名称</view>
          <input class="input" data-field="customExerciseName" value="{{customExerciseName}}" placeholder="例如：羽毛球" bindinput="onManualInput" />
        </view>
        <view class="two-column">
          <view class="form-item">
            <view class="form-label">时长（分钟）</view>
            <input class="input" type="number" data-field="customExerciseDuration" value="{{customExerciseDuration}}" placeholder="30" bindinput="onManualInput" />
          </view>
          <view class="form-item">
            <view class="form-label">参考消耗（kcal）</view>
            <input class="input" type="digit" data-field="customExerciseKcal" value="{{customExerciseKcal}}" placeholder="请自行填写" bindinput="onManualInput" />
          </view>
        </view>
      </block>

      <button class="primary-button" bindtap="saveExercise">保存运动记录</button>
      <view class="disclaimer">运动消耗为估算值，受运动强度、动作效率与个体差异影响，仅作记录参考。</view>
    </view>

    <view class="section-head">
      <view class="section-title">当日运动</view>
      <view class="small muted">{{exerciseRecords.length}} 条</view>
    </view>
    <view class="card record-list" wx:if="{{exerciseRecords.length}}">
      <view class="record-row" wx:for="{{exerciseRecords}}" wx:key="id">
        <view class="record-row__icon record-row__icon--blue">动</view>
        <view class="grow">
          <view class="strong">{{item.name}}</view>
          <view class="tiny muted">{{item.duration}} 分钟 · {{item.source === 'manual' ? '手动录入' : '运动库估算'}}</view>
        </view>
        <view class="record-row__value">{{item.kcal}} kcal</view>
        <button class="delete-link" data-collection="exerciseRecords" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
      </view>
    </view>
    <view class="card empty" wx:else>当天暂无运动记录</view>
  </block>

  <block wx:elif="{{activeTab === 'weight'}}">
    <view class="card">
      <view class="section-head">
        <view class="section-title">记录体重</view>
        <view class="tag">BMI {{weightBmi || '--'}}</view>
      </view>
      <view class="small muted">建议每周记录 1 至 3 次，无需强制每日称重。</view>
      <view class="form-item top-gap">
        <view class="form-label">体重（kg）</view>
        <input class="input" type="digit" value="{{weightInput}}" placeholder="请输入体重" bindinput="onWeightInput" />
      </view>
      <button class="primary-button" bindtap="saveWeight">保存 {{selectedDate}} 的体重</button>
      <view class="disclaimer">BMI 仅展示由身高、体重计算得出的数值，不提供体型分类或健康评价。</view>
    </view>

    <view class="card chart-card" wx:if="{{weightRecords.length}}">
      <view class="row-between">
        <view class="section-title">体重趋势</view>
        <view class="tiny muted">{{weightChartMeta}}</view>
      </view>
      <canvas type="2d" id="weightTrend" class="weight-chart"></canvas>
      <view class="tiny muted chart-note">最近最多展示 14 次体重记录</view>
    </view>

    <view class="section-head">
      <view class="section-title">历史记录</view>
      <view class="small muted">{{weightRecords.length}} 次</view>
    </view>
    <view class="card record-list" wx:if="{{weightRecords.length}}">
      <view class="record-row" wx:for="{{weightRecords}}" wx:key="id">
        <view class="record-row__icon record-row__icon--gold">秤</view>
        <view class="grow">
          <view class="strong">{{item.weight}} kg</view>
          <view class="tiny muted">{{item.date}}</view>
        </view>
        <button class="delete-link" data-collection="weightRecords" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
      </view>
    </view>
    <view class="card empty" wx:else>暂无体重记录</view>
  </block>

  <block wx:elif="{{activeTab === 'period'}}">
    <view class="card">
      <view class="section-head">
        <view class="section-title">记录经期</view>
        <button class="text-button" bindtap="hidePeriod">隐藏模块</button>
      </view>
      <view class="two-column">
        <view class="form-item">
          <view class="form-label">开始日期</view>
          <picker mode="date" value="{{periodStart}}" bindchange="onPeriodStartChange">
            <view class="picker">{{periodStart}}</view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">结束日期</view>
          <picker mode="date" value="{{periodEnd}}" bindchange="onPeriodEndChange">
            <view class="picker">{{periodEnd}}</view>
          </picker>
        </view>
      </view>
      <button class="primary-button" bindtap="savePeriod">保存经期记录</button>
      <view class="disclaimer">经期推算仅供预估参考，个体生理周期存在差异，不作为诊疗依据。</view>
    </view>

    <view class="card prediction-card" wx:if="{{periodPrediction}}">
      <view class="row-between">
        <view class="section-title">周期预估</view>
        <view class="tag">平均 {{periodPrediction.cycleLength}} 天</view>
      </view>
      <view class="prediction-grid">
        <view class="prediction-item">
          <view class="tiny muted">预估下次经期</view>
          <view class="prediction-item__value">{{periodPrediction.nextStartLabel}}</view>
        </view>
        <view class="prediction-item">
          <view class="tiny muted">预估排卵日</view>
          <view class="prediction-item__value prediction-item__value--blue">{{periodPrediction.ovulationLabel}}</view>
        </view>
      </view>
      <view class="small muted">预估易孕期：{{periodPrediction.fertileStart}} 至 {{periodPrediction.fertileEnd}}</view>
      <view class="disclaimer">以上结果仅依据历史日期进行简单推算，不能用于避孕、备孕诊断或其他医疗决策。</view>
    </view>

    <view class="section-head">
      <view class="section-title">历史记录</view>
      <view class="small muted">{{periodRecords.length}} 条</view>
    </view>
    <view class="card record-list" wx:if="{{periodRecords.length}}">
      <view class="record-row" wx:for="{{periodRecords}}" wx:key="id">
        <view class="record-row__icon record-row__icon--rose">期</view>
        <view class="grow">
          <view class="strong">{{item.start}} 至 {{item.end}}</view>
          <view class="tiny muted">共 {{item.days}} 天</view>
        </view>
        <button class="delete-link" data-collection="periodRecords" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
      </view>
    </view>
    <view class="card empty" wx:else>暂无经期记录</view>
  </block>
</view>
