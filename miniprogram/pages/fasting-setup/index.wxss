.setup-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.setup-hero {
  padding: 0 0 32rpx;
}

.setup-hero__eyebrow {
  color: #777777;
  font-size: 24rpx;
}

.setup-hero__title {
  margin-top: 8rpx;
  color: #333333;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}

.setup-hero__text {
  margin-top: 14rpx;
  color: #777777;
  font-size: 28rpx;
}

.stopped-banner {
  margin-bottom: 32rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 24rpx;
  color: #777777;
  background: #ffffff;
  font-size: 24rpx;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.template-card {
  min-height: 176rpx;
  padding: 32rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 24rpx;
  text-align: left;
  background: #ffffff;
}

.template-card--active {
  border-color: #2f7257;
  background: #e6f1ed;
}

.template-card__name {
  color: #333333;
  font-size: 36rpx;
  font-weight: 600;
}

.template-card__desc {
  margin-top: 10rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 1.5;
}

.time-card {
  margin-top: 32rpx;
}

.top-gap {
  margin-top: 24rpx;
}

.two-column {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.window-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 8rpx;
}

.window-summary__item {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #e6f1ed;
}

.window-summary__value {
  margin-top: 4rpx;
  color: #333333;
  font-size: 32rpx;
  font-weight: 600;
}

.window-summary__value--green {
  color: #2f7257;
}

.weekly-note {
  margin-top: 32rpx;
}

.weekly-note__title {
  margin-bottom: 7rpx;
  color: #333333;
  font-size: 32rpx;
  font-weight: 500;
}

.save-button {
  margin-top: 32rpx;
}

.stop-plan-button {
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 16rpx;
  color: #777777;
  background: #ffffff;
  font-weight: 500;
}

.stop-plan-note {
  margin-top: 12rpx;
  color: #999999;
  text-align: center;
  font-size: 24rpx;
}

.modal-mask {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx;
  background: rgba(22, 31, 27, 0.58);
}

.risk-modal {
  width: 100%;
  padding: 38rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.risk-modal__symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #2f7257;
  font-size: 36rpx;
  font-weight: 600;
}

.risk-modal__title {
  margin-top: 22rpx;
  color: #333333;
  font-size: 36rpx;
  font-weight: 600;
}

.risk-modal__content {
  margin-top: 16rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.75;
}

.risk-check {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 28rpx 0;
  text-align: left;
}

.risk-check__box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 38rpx;
  width: 38rpx;
  height: 38rpx;
  margin-top: 2rpx;
  border: 2rpx solid #eeeeee;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.risk-check__box--active {
  border-color: #2f7257;
  background: #2f7257;
}

.risk-check__text {
  color: #333333;
  font-size: 28rpx;
}
