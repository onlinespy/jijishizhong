page {
  width: 100vw;
  max-width: 100vw;
  min-height: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
  background: #ffffff;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
scroll-view,
text,
button,
input,
textarea,
picker,
switch {
  box-sizing: border-box !important;
  min-width: 0 !important;
  max-width: 100%;
}

view,
text,
button {
  word-break: break-all;
  overflow-wrap: anywhere;
}

.page view,
.page button,
.page input,
.page textarea,
.page picker {
  max-width: 100%;
}

.card > view,
.card > button,
.card > input,
.card > textarea,
.card > picker {
  max-width: 100%;
}

button {
  margin: 0;
  padding: 0;
  font-size: inherit;
  line-height: inherit;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 24rpx 16rpx 64rpx;
}

.page--tab {
  padding: 24rpx 16rpx calc(168rpx + env(safe-area-inset-bottom));
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  margin-bottom: 16rpx;
}

.section-title {
  color: #333333;
  font-size: 32rpx;
  font-weight: 500;
}

.section-note {
  color: #777777;
  font-size: 24rpx;
}

.card {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  padding: 32rpx 0;
  border: 1rpx solid #eeeeee;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card > view,
.card > button,
.card > input,
.card > textarea,
.card > picker {
  padding-right: 16rpx;
  padding-left: 16rpx;
}

.card + .card {
  margin-top: 24rpx;
}

.muted {
  color: #777777;
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 24rpx;
}

.strong {
  font-weight: 500;
}

.row {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
}

.grow {
  flex: 1;
  min-width: 0;
}

.divider {
  height: 1rpx;
  margin: 22rpx 0;
  background: #eeeeee;
}

.primary-button,
.secondary-button,
.text-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.primary-button {
  color: #ffffff;
  background: #2f7257;
}

.primary-button[disabled] {
  color: #999999;
  background: #eeeeee;
}

.secondary-button {
  color: #2f7257;
  border: 1rpx solid #2f7257;
  background: #ffffff;
}

.text-button {
  display: inline-flex;
  min-height: auto;
  color: #2f7257;
  font-size: 24rpx;
}

.danger-button {
  color: #777777;
  border: 1rpx solid #eeeeee;
  background: #ffffff;
}

.button-row {
  display: flex;
  width: 100%;
  min-width: 0;
  gap: 16rpx;
}

.button-row > button {
  flex: 1;
  min-width: 0;
}

.row > view,
.row > button,
.row-between > view,
.row-between > button,
.button-row > button,
.segmented > button,
.tab-switch > button,
.water-buttons > button,
.more-record-row > button,
.inline-field > view,
.inline-field > input,
.unit-row > button,
.preview-line > view,
.water-tools > view,
.water-tools > button,
.water-reminder > view,
.water-reminder > switch {
  min-width: 0 !important;
}

.button-row,
.segmented,
.tab-switch,
.water-buttons,
.more-record-row,
.inline-field,
.unit-row,
.preview-line,
.water-tools,
.water-reminder {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  margin-bottom: 16rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 500;
}

.input,
.picker,
.textarea {
  width: 100%;
  max-width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #eeeeee;
  border-radius: 16rpx;
  color: #333333;
  background: #ffffff;
}

.textarea {
  min-height: 160rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.placeholder {
  color: #999999;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  max-width: 100%;
  padding: 14rpx 20rpx;
  border: 1rpx solid #2f7257;
  border-radius: 16rpx;
  color: #777777;
  background: #ffffff;
  font-size: 28rpx;
}

.chip--active {
  color: #ffffff;
  border-color: #2f7257;
  background: #2f7257;
  font-weight: 500;
}

.disclaimer {
  margin-top: 40rpx;
  padding: 0;
  border: 0;
  color: #999999;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.65;
}

.empty {
  padding: 48rpx 32rpx;
  color: #999999;
  text-align: center;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  color: #2f7257;
  background: #e6f1ed;
  font-size: 24rpx;
}

.tag--active {
  color: #2f7257;
  background: #e6f1ed;
}

.tag--stopped {
  color: #777777;
  background: #eeeeee;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
